# Meta Ads MCP Server Configuration
# ─────────────────────────────────────────────────────────────────
# Copy to `.env` and fill the values for your deployment.
# Never commit `.env` — it is gitignored.

# ── Public URL of this server (required in production) ─────────
# e.g. https://meta-ads-mcp-xxx.run.app or http://localhost:3000
SERVER_URL=

# ── Browser origins allowed to call /mcp (optional) ─────────────
# Comma-separated. /authorize and /auth/* are top-level navigations and do not
# depend on this.
CORS_ALLOWED_ORIGINS=
# When empty the default is https://claude.ai and https://claude.com. Setting it
# replaces the defaults, so list every origin you need. A request without an Origin header (non-browser MCP clients)
# is always accepted; any other Origin gets 403 on /mcp.

# ── Extra OAuth redirect hosts (optional) ───────────────────────
# Dynamic client registration only accepts these redirect URIs by default:
# https://claude.ai/api/mcp/auth_callback and https://claude.com/api/mcp/auth_callback
# (exactly that path), loopback http (127.0.0.1, localhost, [::1]) and the
# cursor://, vscode:// and vscode-insiders:// schemes.
# Add other exact host names here: comma-separated, no scheme, port, path or
# wildcard. Every path on a listed host is then accepted.
# chatgpt.com is NOT a default: anyone can publish a Custom GPT whose callback
# is on that host. List it only if ChatGPT is a client you use.
# Example: chatgpt.com,platform.openai.com,vscode.dev,insiders.vscode.dev
OAUTH_EXTRA_ALLOWED_REDIRECT_HOSTS=
# cursor://, vscode:// and vscode-insiders:// redirects are accepted only for
# the application hosts built in (anysphere.cursor-retrieval, anysphere.cursor-mcp,
# vscode.github-authentication; UNVERIFIED against the real clients). Add others
# here as bare host names, comma-separated, e.g. a VS Code extension id.
OAUTH_EXTRA_ALLOWED_APP_HOSTS=

# ── Meta App credentials (required for OAuth login flow) ──────
# Create an App at developers.facebook.com → Add product "Facebook Login"
# Configure Valid OAuth Redirect URI: <SERVER_URL>/auth/meta/callback
META_APP_ID=
# Facebook Login for Business user-token configuration. Requires verified same-app user IDs below.
META_LOGIN_CONFIG_ID=
META_APP_SECRET=
# Optional override; auto-derived from SERVER_URL if absent
META_OAUTH_REDIRECT_URI=

# ── Allowlist (at least one source required when META_APP_ID is set) ──
# Only listed identities can complete the Meta login flow.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_FB_USER_IDS=

# ── Deny list (optional) ────────────────────────────────────────
# Comma-separated Facebook user ids that are refused even when they match the
# allowlist: login, /authorize, code exchange, refresh and every /mcp request.
# Takes effect once the process runs with the new value; a denied user's
# refresh token is also burned.
AUTH_DENIED_FB_USER_IDS=

# ── Rate limits ─────────────────────────────────────────────────
# The sizes are fixed in code (see docs/authentication.md). What you set is how
# many reverse proxies sit in front of this server (0 to 10, default 1), which
# decides the X-Forwarded-For entry that counts as the client address. Too low:
# every client shares the proxy's address. Too high: a client can pick its own.
# Any other value stops the server at startup.
TRUST_PROXY_HOPS=

# ── Encryption & sessions ─────────────────────────────────────
# Used to encrypt Meta tokens at rest in Firestore (AES-256-GCM)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Used to sign session cookies (>= 32 chars random)
# Generate with: openssl rand -base64 32
SESSION_COOKIE_SECRET=

# Used to sign MCP OAuth JWTs (>= 32 chars random)
# Generate with: openssl rand -hex 32
OAUTH_SECRET=

# ── Firestore (where encrypted tokens live) ──────────────────
# Defaults to GOOGLE_CLOUD_PROJECT when running on GCP.
# For local dev, point FIRESTORE_EMULATOR_HOST to the emulator.
FIRESTORE_PROJECT_ID=
# FIRESTORE_EMULATOR_HOST=localhost:8085

# ── Legacy / single-tenant fallbacks (optional) ──────────────
# If set, used as a fallback when no per-user token is available.
META_ACCESS_TOKEN=
# Multi-token JSON: {"agency_a":"EAA...","agency_b":"EAA..."}
META_TOKENS=
# Service-to-service API key (skips OAuth entirely)
# At least 32 characters or the server refuses to start: openssl rand -hex 32
# Without META_APP_ID/META_APP_SECRET this is the only way into /mcp; the OAuth
# endpoints are not served in that mode.
MCP_API_KEY=

# ── Apify (Meta Ad Library scraping, optional) ───────────────
# The primary path is per-tenant: each user registers their own token with
# ads_library_register_apify_token and it is stored encrypted in Firestore.
# This env var is only a fallback for stdio / single-operator deployments.
# Get a token at https://console.apify.com/settings/integrations
APIFY_TOKEN=

# ── Video analysis (ads_get_video_media, optional) ───────────
# Keyframe extraction and compact transcodes need ffmpeg + ffprobe on PATH
# (the Docker image installs them). Override the binaries if they live elsewhere.
FFMPEG_PATH=
FFPROBE_PATH=
# Hard limits for downloaded videos: bytes (default 150 MB) and duration (default 240 s).
VIDEO_MAX_BYTES=
VIDEO_MAX_SECONDS=
# Concurrency and budgets: jobs per instance (default 2), per-call time budget in ms
# (default 240000, keep under the Cloud Run request timeout), per-tenant jobs per hour (default 30).
VIDEO_MAX_CONCURRENT_JOBS=
VIDEO_CALL_BUDGET_MS=
VIDEO_JOBS_PER_TENANT_PER_HOUR=
# Comma-separated host suffixes videos may be fetched from (default: .fbcdn.net,.facebook.com,.cdninstagram.com).
VIDEO_ALLOWED_HOST_SUFFIXES=

# ── Gemini video analysis (ads_analyze_video, optional) ──────
# For agents whose own model cannot watch video. The primary path is
# per-tenant: each user registers their own key with ads_register_gemini_key
# (or on /auth/connections) and it is stored encrypted in Firestore. This env
# var is only a fallback for stdio / single-operator deployments.
# Create a key at https://aistudio.google.com/apikey — use a paid-tier key for
# client creatives, since Google may use free-tier inputs to improve its models.
GEMINI_API_KEY=
# Model used for analysis. Optional; defaults to gemini-3.8-flash. Only ids
# matching gemini-<something> are accepted.
GEMINI_MODEL=
# Videos at or below this size are embedded in the request; larger ones go
# through the Files API and are deleted right after (default 12 MB).
GEMINI_INLINE_MAX_BYTES=
# Above this size the video is transcoded down before it is sent (default 40 MB).
GEMINI_MAX_UPLOAD_BYTES=
# Billable analyses per tenant per hour, per instance (default 20). Cached
# repeats do not count.
GEMINI_ANALYSES_PER_TENANT_PER_HOUR=

# ── Server settings ──────────────────────────────────────────
# Graph/Marketing API version for every Meta call. Optional: the code defaults
# to the version in src/meta/api-version.ts, and tests/meta/api-version.test.ts
# fails if this pin, docker-compose.yml, README.md or deploy.yml drift from it.
META_API_VERSION=v26.0
PORT=3000
LOG_LEVEL=info
NODE_ENV=production

# ── Lumin Meta Platform V1 candidate (disabled by default) ──
# These are deployment gates, not authorization. Keep off until the exact
# candidate, isolated staging registry and provider profiles are approved.
LUMIN_PLATFORM_ENABLED=false
LUMIN_PLATFORM_WRITES_ENABLED=false
LUMIN_PLATFORM_OAUTH_ENABLED=false
LUMIN_PLATFORM_OAUTH_PROFILES_JSON=
LUMIN_WHATSAPP_ENROLLMENT_BINDINGS_JSON=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_API_VERSION=v1.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Independent Instagram execution requires the reviewed version explicitly.
INSTAGRAM_API_VERSION=v26.0
LUMIN_PLATFORM_WEBHOOKS_ENABLED=false
META_WEBHOOK_SUBSCRIPTIONS_JSON=
LUMIN_PLATFORM_MESSAGING_POLICY_ENABLED=false
MESSAGING_RECIPIENT_HMAC_KEY=
LUMIN_PLATFORM_SIGNALS_ENABLED=false
LUMIN_FIRST_PARTY_ADAPTER_ID=
LUMIN_FIRST_PARTY_INGRESS_ENABLED=false
LUMIN_FIRST_PARTY_INGRESS_PROFILES_JSON=
LUMIN_PLATFORM_DISCOVERY_ENABLED=false
LUMIN_MEDIA_INGRESS_ENABLED=false
LUMIN_MEDIA_INGRESS_PROFILES_JSON=
LUMIN_PLATFORM_OPERATIONS_ENABLED=false
LUMIN_OPERATIONAL_WORKERS_JSON=
LUMIN_OPERATIONAL_INGRESS_JSON=
LUMIN_WEBHOOK_INDEX_REFRESH_BINDINGS_JSON=
# Profile JSON contains named references only. Create independent approved
# LUMIN_FIRST_PARTY_INGRESS_KEY_*, LUMIN_MEDIA_INGRESS_KEY_* and LUMIN_WORKER_KEY_*
# values in the secret store; never put values in JSON, tools, logs or source.
# See docs/environment-reference.md and the pure bootstrap dry-run plans.

# Signed Meta privacy callbacks and separately authenticated bounded cleanup worker.
LUMIN_META_PRIVACY_ENABLED=false
LUMIN_META_PRIVACY_IDENTITIES_JSON=
LUMIN_META_PRIVACY_WORKERS_JSON=
# Add only named LUMIN_PRIVACY_WORKER_KEY_* secrets in the platform secret store.

# Tokenless public oEmbed: authenticated frontend previews only, no model HTML/metadata.
LUMIN_PLATFORM_OEMBED_ENABLED=false

# Authenticated exact client/app/connection evidence review; no provider activation.
LUMIN_ELIGIBILITY_REVIEW_ENABLED=false

# Messenger Utility messages (default-off source ingress)
LUMIN_MESSENGER_UTILITY_ENABLED=false
# 32-byte hex HMAC key; provision in the platform secret store.
# LUMIN_UTILITY_RECIPIENT_HMAC_KEY=
# LUMIN_UTILITY_SOURCE_SECRET=
# Server-owned JSON contains references only, never embedded secrets:
# LUMIN_UTILITY_SOURCE_PROFILES_JSON=[{"adapterId":"transaction-backend","scope":{"tenantId":"TENANT","clientId":"CLIENT","appId":"META_APP_ID","pageId":"PAGE_ID"},"secretReference":"LUMIN_UTILITY_SOURCE_SECRET"}]

# Client-scoped local failure diagnostics; seven-day retention, no provider health claim.
LUMIN_HEALTH_ENABLED=false

# Trusted reviewed Messenger MP3/PDF sources; keys are platform-store references.
LUMIN_MESSAGING_ATTACHMENTS_ENABLED=false
# Deprecated compatibility alias: LUMIN_MESSENGER_ATTACHMENTS_ENABLED (if present, must match).
# LUMIN_ATTACHMENT_PROFILES_JSON=
# LUMIN_ATTACHMENT_INGRESS_KEY_<PROFILE>=

# Human admin-only new-client/root declarations. No grants or provider calls.
LUMIN_CLIENT_ENROLLMENT_ENABLED=false

# Official archive research and optional paid-provider preparation
LUMIN_AD_LIBRARY_ENABLED=false
LUMIN_PAID_RESEARCH_ENABLED=false
# Existing-ad owner-reviewed activation/deletion, never enabled by creation.
LUMIN_MARKETING_ACTIVATION_ENABLED=false
LUMIN_MARKETING_DELETION_ENABLED=false

# Human-only WhatsApp phone setup; never enable without exact owner-reviewed profiles.
LUMIN_WHATSAPP_SETUP_ENABLED=false
# LUMIN_WHATSAPP_SETUP_PROFILES_JSON=[]

# Protected human client Business ownership review (default off)
LUMIN_BUSINESS_OWNER_BINDINGS_ENABLED=false

# Local paused-ad planning only; every ad still needs a fresh separate human approval.
LUMIN_PAUSED_AD_BATCH_ENABLED=false

# Supervised tracking proposal; two fresh approvals, no automatic activation.
LUMIN_TRACKING_CHANGE_ENABLED=false
LUMIN_MARKETING_CREATIVE_REPLACEMENT_ENABLED=false
LUMIN_MARKETING_STUDIES_ENABLED=false

LUMIN_MARKETING_PREVIEWS_ENABLED=false

# Instant Form CRM stage integration: disabled until reviewed source and credential setup.
LUMIN_CRM_SIGNALS_ENABLED=false
LUMIN_CRM_SOURCE_INGRESS_ENABLED=false
# LUMIN_CRM_SUBJECT_HMAC_KEY=<generate-and-store-in-platform-secret-store>
# LUMIN_CRM_PROFILES_JSON=<reviewed-immutable-client-profiles-with-secret-reference-names>

# Finance-role-verified client invoice metadata only; never exposes amounts or download URLs.
LUMIN_INVOICE_METADATA_ENABLED=false

# Independent registered Marketing/catalog READ diagnostics; no inventory expansion.
LUMIN_CATALOG_CAMPAIGN_DIAGNOSTICS_ENABLED=false

# Authenticated own-client sampled video frames; no paid semantic analysis.
LUMIN_VIDEO_INSPECTION_ENABLED=false

# App-install candidate: immutable reviewed app/account/Page/store binding, separate human access and paused approvals.
LUMIN_MARKETING_APP_PROMOTION_ENABLED=false
LUMIN_MARKETING_APP_PROMOTION_BINDINGS_JSON=[]

# Promoted-app event names only; no event parameters or optimization eligibility inferred.
LUMIN_APP_EVENT_TYPES_ENABLED=false

# Protected read-only Pixel/Dataset discovery under explicit client Business/account roots.
LUMIN_SIGNAL_ASSET_DISCOVERY_ENABLED=false

# Conservative actual USER inspection for CRM dispatch; does not admit unverified Events Manager/system tokens.
LUMIN_CRM_USER_CREDENTIAL_INSPECTION_ENABLED=false

# Optional pinned public-ad acquisition. Human vendor/budget approval and current reviewed policy required.
LUMIN_APIFY_PUBLIC_ADS_ENABLED=false
LUMIN_APIFY_PUBLIC_ADS_POLICY_JSON=
# Platform secret store only; never paste this value into MCP arguments or source.
LUMIN_APIFY_API_KEY=

# Separately reviewed Apify-maintained public-ad acquisition; never substitutes community actor schemas.
LUMIN_APIFY_OFFICIAL_ADS_ENABLED=false
LUMIN_APIFY_OFFICIAL_ADS_POLICY_JSON=
# Platform secret store only; no value belongs in source or MCP tool arguments.
LUMIN_APIFY_OFFICIAL_API_KEY=

# Separate reviewed Purchase app-event optimization candidate; no activation.
LUMIN_MARKETING_APP_PURCHASE_ENABLED=false

# Private current-client JPEG visual inspection; no semantic/paid analysis.
LUMIN_IMAGE_INSPECTION_ENABLED=false

# Additional source-supported slices; each requires its own reviewed configuration.
LUMIN_GEMINI_TEXT_ENABLED=false
LUMIN_MARKETING_CBO_ENABLED=false
LUMIN_MARKETING_VIDEO_CREATIVE_ENABLED=false
LUMIN_MESSENGER_ATTACHMENTS_ENABLED=false
LUMIN_PAGE_VIDEO_ENABLED=false
LUMIN_PUBLISHING_VIDEO_ENABLED=false
LUMIN_VIDEO_INGRESS_ENABLED=false

# Locked agency candidate; reviewed credentials/configuration required before agency mode.
DEPLOYMENT_MODE=awaiting_credentials

# Locked agency candidate; reviewed credentials/configuration required before agency mode.
AGENCY_WRITES_ENABLED=false

# Separation of duties for human approvals (the requester cannot approve their own request).
# Unset: on when DEPLOYMENT_MODE=agency and both write flags are true, off otherwise.
# false opts out and true forces it on; any other value, including an empty one, fails closed to on.
# LUMIN_APPROVAL_REQUIRE_DISTINCT_APPROVER=true

# Per-client budget ceilings, strict JSON with no default. Without an entry a budget-bearing write or activation is denied.
# LUMIN_MARKETING_BUDGET_CEILINGS={"version":1,"clients":{"example-client":{"currency":"USD","max_daily_budget":"500.00","max_lifetime_budget":"5000.00"}}}
